# Provider: kilo (default when unset) | openrouter | vercel-ai-gateway | nvidia
# An unknown MOTS_PROVIDER fails session startup.
# MOTS_PROVIDER=kilo
# Model defaults from packages/agent/src/provider.ts (DEFAULT_MODELS).
# Leave MOTS_MODEL unset to use the row for the selected provider.
#   kilo                -> reflection/beam-free
#   openrouter          -> openai/gpt-6-luna
#   vercel-ai-gateway   -> reflection/beam-free
#   nvidia              -> nvidia/nemotron-3.5-lightning-30b-a3b
# MOTS_MODEL=reflection/beam-free

# Required before any session can be created or joined. At least 16 characters.
# Generate with: openssl rand -base64 32
# Rotating MOTS_SESSION_SECRET invalidates every existing join code.
MOTS_SESSION_SECRET=
# Required on POST /api/sessions as `Authorization: Bearer <token>`.
# A public app binary can be unpacked, so this stops anonymous callers, not a determined one.
MOTS_CREATE_TOKEN=

# Browser origins allowed to call the Worker. Leave unset to allow every origin.
# Native apps do not send Origin. Set this before exposing a web client.
# MOTS_CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Optional spend caps. Defaults: 8 creates / 10 minutes / address, 60 connects / minute,
# 8 active schedules, recurrence no faster than every 15 minutes.
# Limits are per Worker isolate. Put an edge rate limit in front of a public hostname.
# MOTS_CREATE_LIMIT=8
# MOTS_CREATE_WINDOW_SECONDS=600
# MOTS_CONNECT_LIMIT=60
# MOTS_CONNECT_WINDOW_SECONDS=60
# MOTS_MAX_SCHEDULES=8
# MOTS_MIN_RECURRENCE_SECONDS=900
# MOTS_DAILY_PROMPT_LIMIT=100

# kilo (default). If unset, local dev may read ~/.pi/agent/auth.json or send the literal key free.
# KILO_API_KEY=

# openrouter. Used only when MOTS_PROVIDER=openrouter. Default model: openai/gpt-6-luna.
# OPENROUTER_API_KEY=

# vercel-ai-gateway. Secret name is AI_GATEWAY_API_KEY. Host: https://ai-gateway.vercel.sh/v1
# AI_GATEWAY_API_KEY=

# nvidia (https://build.nvidia.com)
# NVIDIA_API_KEY=

# Optional. Makes the web_search tool use Tavily (https://tavily.com) instead of Exa.
# Without it web_search uses Exa and Parallel in rotation; neither needs a key.
# TAVILY_API_KEY=

# Optional Expo access token for reminder pushes (https://expo.dev).
# When set, a delivered reminder sends it as `Authorization: Bearer <token>`.
# When unset or blank, the push is sent without that header.
# EXPO_ACCESS_TOKEN=
