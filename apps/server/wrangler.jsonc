{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mots",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "Session"
      }
    ]
  },
  "exports": {
    "Session": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
