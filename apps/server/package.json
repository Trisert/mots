{
  "name": "@mots/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:lan": "wrangler dev --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "@mots/agent": "workspace:*",
    "@mots/protocol": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261021.1",
    "typescript": "~6.0.3",
    "wrangler": "4.151.3"
  }
}
